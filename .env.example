# ==============================================================================
# Telegram ChatGPT Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your real '.env' file containing secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Essential Credentials (REQUIRED)
# ------------------------------------------------------------------------------

# Telegram Bot Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# OpenAI API Key (or key from an OpenAI-compatible API provider like OpenRouter/DeepSeek/Groq)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ------------------------------------------------------------------------------
# 2. Access Control & Permissions
# ------------------------------------------------------------------------------

# Comma-separated list of Telegram User IDs for administrators (can use admin commands like /stats), or '-' for no admin
ADMIN_USER_IDS=YOUR_ADMIN_TELEGRAM_USER_ID

# Comma-separated list of Telegram User IDs allowed to use the bot, or '*' to allow everyone
ALLOWED_TELEGRAM_USER_IDS=*

# ------------------------------------------------------------------------------
# 3. Model Configuration
# ------------------------------------------------------------------------------

# Base URL for OpenAI-compatible API (e.g., https://api.openai.com/v1)
OPENAI_BASE_URL=YOUR_OPENAI_BASE_URL

# Default model used for chat completions (e.g., gpt-4o, claude-3-5-sonnet, deepseek-chat)
OPENAI_MODEL=YOUR_OPENAI_MODEL

# Comma-separated list of models available to switch between using /model command
OPENAI_MODELS=YOUR_MODEL_1,YOUR_MODEL_2,YOUR_MODEL_3

# System prompt file path (default: system_prompt.txt if present)
ASSISTANT_PROMPT_FILE=system_prompt.txt

# Fallback system prompt text if ASSISTANT_PROMPT_FILE is not used
# ASSISTANT_PROMPT="You are a helpful assistant."

# Model generation parameters
MAX_TOKENS=1200
TEMPERATURE=1.0
N_CHOICES=1
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0

# Context & Conversation History Management
MAX_HISTORY_SIZE=15
MAX_CONVERSATION_AGE_MINUTES=180

# ------------------------------------------------------------------------------
# 4. Features & Interface Behavior
# ------------------------------------------------------------------------------

# Stream responses as they are generated (true/false)
STREAM=true

# Show token usage details in replies (true/false)
SHOW_USAGE=false

# Quote the user's message when replying (true/false)
ENABLE_QUOTING=false

# Enable function calling / tool use (true/false)
ENABLE_FUNCTIONS=true
FUNCTIONS_MAX_CONSECUTIVE_CALLS=10
SHOW_PLUGINS_USED=false

# Bot UI language: 'en' for English, 'zh' for Simplified Chinese, etc.
BOT_LANGUAGE=en

# Group chat behavior
GROUP_TRIGGER_KEYWORD=""
IGNORE_GROUP_TRANSCRIPTIONS=true
IGNORE_GROUP_VISION=true

# HTTP/SOCKS5 Proxy (e.g., http://127.0.0.1:7890 or socks5://127.0.0.1:1080)
# PROXY=YOUR_PROXY_URL

# ------------------------------------------------------------------------------
# 5. Image Generation (DALL-E / Compatible Endpoints)
# ------------------------------------------------------------------------------

# Enable or disable image generation via /image command
ENABLE_IMAGE_GENERATION=true

# Model name for image generation (e.g., dall-e-3, gpt-image-2)
IMAGE_MODEL=YOUR_IMAGE_MODEL

# Optional separate API key for image generation (leave unset to reuse OPENAI_API_KEY)
# IMAGE_API_KEY=YOUR_IMAGE_API_KEY

# Default image resolution (e.g., 1024x1024, 512x512, 1792x1024, 1024x1792)
IMAGE_SIZE=1024x1024

# Image quality: 'standard' or 'hd' or 'auto'
IMAGE_QUALITY=standard

# Image style: 'vivid' or 'natural'
IMAGE_STYLE=vivid

# How images are sent to Telegram: 'photo' (compressed) or 'document' (uncompressed)
IMAGE_FORMAT=photo

# ------------------------------------------------------------------------------
# 6. Vision (Image Recognition)
# ------------------------------------------------------------------------------

# Enable or disable vision analysis of sent images
ENABLE_VISION=true

# Default prompt when user sends an image without caption
VISION_PROMPT="What is in this image"

# Vision detail level: 'auto', 'low', or 'high'
VISION_DETAIL=auto

# Maximum tokens for vision response
VISION_MAX_TOKENS=300

# Allow multi-turn follow-up questions about the previously sent image
ENABLE_VISION_FOLLOW_UP_QUESTIONS=true

# ------------------------------------------------------------------------------
# 7. Audio Transcription (Speech-to-Text / STT)
# ------------------------------------------------------------------------------

# Enable or disable voice/audio message transcription
ENABLE_TRANSCRIPTION=true

# Audio API endpoint and key (defaults to OPENAI_BASE_URL and OPENAI_API_KEY)
AUDIO_BASE_URL=YOUR_AUDIO_BASE_URL
AUDIO_API_KEY=YOUR_AUDIO_API_KEY
AUDIO_MODEL=YOUR_AUDIO_MODEL
WHISPER_PROMPT=""

# Reply to voice messages with text transcript only without triggering LLM response
VOICE_REPLY_WITH_TRANSCRIPT_ONLY=false

# Optional trigger phrases for voice reply
# VOICE_REPLY_PROMPTS="Hi bot;Hey bot;Hi chat;Hey chat"

# ------------------------------------------------------------------------------
# 8. Text-to-Speech (TTS)
# ------------------------------------------------------------------------------

# Enable or disable TTS generation via /tts command
ENABLE_TTS_GENERATION=true

# TTS API Base URL (OpenAI TTS or Fish Audio compatible endpoint)
TTS_BASE_URL=YOUR_TTS_BASE_URL
TTS_API_KEY=YOUR_TTS_API_KEY
TTS_MODEL=YOUR_TTS_MODEL

# Default voice name
TTS_VOICE=YOUR_TTS_DEFAULT_VOICE

# Voice mapping list (comma-separated reference_id:DisplayName)
TTS_VOICES="YOUR_VOICE_ID_1:VoiceName1,YOUR_VOICE_ID_2:VoiceName2"

# ------------------------------------------------------------------------------
# 9. Budgets & Cost Tracking
# ------------------------------------------------------------------------------

# Budget calculation period ('monthly', 'daily', or 'all-time')
BUDGET_PERIOD=monthly

# Per-user budget limits in USD ('*' for unlimited, or '123456789:10.0,987654321:20.0')
USER_BUDGETS=*

# Budget for guests (users not in USER_BUDGETS) in USD
GUEST_BUDGET=100.0

# Pricing reference rates for cost estimation (USD)
TOKEN_PRICE=0.002
IMAGE_PRICES=0.016,0.018,0.02
TRANSCRIPTION_PRICE=0.006
VISION_TOKEN_PRICE=0.01
TTS_PRICES=0.015,0.030

# ------------------------------------------------------------------------------
# 10. Plugins Configuration
# ------------------------------------------------------------------------------

# Comma-separated list of enabled plugins
PLUGINS=tavily_search,mem0_memory,web_image_embed

# --- Tavily Web Search Plugin ---
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TAVILY_BASE_URL=YOUR_TAVILY_BASE_URL
TAVILY_SHOW_SOURCES=true
TAVILY_MAX_SOURCES=3
# TAVILY_PROJECT_ID=YOUR_TAVILY_PROJECT_ID

# --- Mem0 Long-Term Memory Plugin ---
MEM0_API_KEY=YOUR_MEM0_API_KEY
MEM0_MODEL=YOUR_MEM0_MODEL
MEM0_BASE_URL=YOUR_MEM0_BASE_URL
MEM0_EMBEDDER_BASE_URL=YOUR_MEM0_EMBEDDER_BASE_URL
MEM0_EMBEDDER_API_KEY=YOUR_MEM0_EMBEDDER_API_KEY
MEM0_EMBEDDER_MODEL=YOUR_MEM0_EMBEDDER_MODEL
MEM0_EMBEDDER_DIMS=1536

# --- Video Intelligence Plugin (Google Cloud Video Intelligence) ---
ENABLE_VIDEO_INTELLIGENCE=false
GOOGLE_APPLICATION_CREDENTIALS=YOUR_GOOGLE_APPLICATION_CREDENTIALS_PATH
VIDEO_MAX_FILE_SIZE_MB=20

# --- Additional Optional Plugins ---
# DEEPL_API_KEY=YOUR_DEEPL_API_KEY
# SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
# SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
# SPOTIFY_REDIRECT_URI=YOUR_SPOTIFY_REDIRECT_URI
# WOLFRAM_APP_ID=YOUR_WOLFRAM_APP_ID
# WORLDTIME_DEFAULT_TIMEZONE=Europe/London
# DUCKDUCKGO_SAFESEARCH=moderate
